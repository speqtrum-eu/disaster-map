{
  "name": "disaster-map-backend",
  "version": "1.0.0",
  "description": "FastAPI backend for disaster map viewer",
  "private": true,
  "scripts": {
    "dev": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "start": "uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "test": "pytest tests/ -v",
    "lint": "black --check src tests && flake8 src tests",
    "format": "black src tests",
    "typecheck": "mypy src"
  },
  "dependencies": {
    "fastapi": "^0.109.0",
    "uvicorn[standard]": "^0.27.0",
    "pydantic": "^2.5.3"
  }
}
