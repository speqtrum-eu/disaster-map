# LOG Environment Configuration
# Copy this file to .env.local for local development or deploy/production.env for production

# Redis Connection
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=100

# Output Settings
OUTPUT_DIR=./outputs
DATA_DIR=./data
TEMP_DIR=./temp

# Processing Configuration
MAX_WORKERS=4
BATCH_SIZE=32
LATENCY_BUDGET_MS=1000
THROUGHPUT_TARGET_FPS=30

# Quality Settings
OUTPUT_QUALITY=0.95
COMPRESSION_LEVEL=8
RESOLUTION_METERS=0.5

# GPU Configuration (optional)
GPU_DEVICE=0
USE_GPU=true
CUDA_VISIBLE_DEVICES=0,1

# Performance Tuning
ENABLE_CACHING=true
CACHE_MAX_SIZE=1GB
TIMEOUT_MS=30000
RETRY_ATTEMPTS=3

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
LOG_LEVEL=INFO

# Security
ALLOWED_ORIGINS=http://localhost:8080
API_KEY=change_this_in_production
